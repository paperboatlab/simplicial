# @name@'s domain code: what only this station has. The engine (Simplicial) does the rest: it loads
# descriptor.toml, runs the graph and serves the page; this file runs in a Julia runtime that
# paperboatd starts (a container), and answers the engine's calls. Reference: docs/stations.rst.

# A block: its params arrive as keywords, step runs once per pass of the clock.
struct Scale
    gain::Float64
end
Scale(; gain = 2.0) = Scale(gain)

# ctx: Dict("t", "dt", "id"); inputs and the result: port => value (numbers, vectors, text)
step(b::Scale, ctx, inputs) = Dict("y" => b.gain * get(inputs, "u", 0.0))

# The type the descriptor uses, and what the palette shows.
PaperboatRuntime.register("scale", Scale; definition = Dict(
    "label" => "Scale",
    "description" => "Multiplies its input by a gain.",
    "inputs" => ["u"],
    "outputs" => ["y"],
    "params" => [("gain", 2.0)],
))
